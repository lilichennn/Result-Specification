
# Copy to config/.env and fill only the services used by your workflow.
# Never commit config/.env. Chat base URLs exclude /chat/completions.

# RS generation aliases (scripts/generate_rc.py --llm qwen38, etc.).
qwen38=API1
kimik3=API2
gpt56=API3
opus48=API4
API1=qwen3.8-2.4t-a95b
API1_API_KEY=
API1_BASE_URL=
API2=kimi-k3
API2_API_KEY=
API2_BASE_URL=
API3=gpt-5.6-terra
API3_API_KEY=
API3_BASE_URL=
API4=
API4_API_KEY=
API4_BASE_URL=

# Method experiments: exactly one model identifier, not a list.
# Separate from the aliases above, even when using the same service.
DASH_MODELS=qwen3.8-2.4t-a95b
DASH_API_KEY=
DASH_BASE_URL=

# DeepEye preparation: endpoint appropriate for the embedding service.
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# BIRD-Interact PostgreSQL: read-only evaluation role on working databases.
# Some DeepEye entrypoints validate these fields even for SQLite workloads.
PG_HOST=localhost
PG_PORT=5432
PG_USER=benchmark_reader
PG_PASSWORD=
# PG_SSLMODE=prefer
